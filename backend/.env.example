PORT=4000
HOST=127.0.0.1
MONGO_URI=mongodb://127.0.0.1:27017/packet_analyzer
# Set this to the compiled engine executable. On Windows, CMake creates dpi_engine.exe.
DPI_ENGINE_PATH=../dpi_engine.exe
# Optional: uncomment and set this if dumpcap.exe is not on PATH or in its default location.
# DUMPCAP_PATH=C:/Program Files/Wireshark/dumpcap.exe
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100
MAX_WORKERS=1
ENGINE_TIMEOUT_MS=600000
WEB_ORIGIN=http://localhost:5173
